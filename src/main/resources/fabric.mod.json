{
  "schemaVersion": 1,
  "id": "librarian_trade_cycler",
  "version": "${version}",
  "name": "Villager Trade Finder",
  "description": "Completes each villager trade response and checks every target before immediately requesting the next refresh.",
  "authors": [
    "CNTrident"
  ],
  "contributors": [
    "Uncraftbar (Easy Auto Cycler base)"
  ],
  "contact": {
    "homepage": "https://github.com/CNTrident/villager-trade-finder",
    "sources": "https://github.com/CNTrident/villager-trade-finder",
    "issues": "https://github.com/CNTrident/villager-trade-finder/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.uncraftbar.easyautocycler.network.ConfirmedCycleServer"
    ],
    "client": [
      "com.uncraftbar.easyautocycler.EasyAutoCyclerMod"
    ]
  },
  "mixins": [
    "easyautocycler.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricloader_min}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "trade_cycling": ">=1.0.21"
  },
  "suggests": {
    "visibletraders": ">=2.4.0"
  },
  "breaks": {
    "easyautocycler": "*"
  }
}
